{
  "name": "grasp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "npm run lint:design && npm run lint:styles && eslint .",
    "lint:design": "node scripts/check-design-tokens.mjs",
    "lint:styles": "stylelint \"app/**/*.css\" \"components/**/*.css\" \"styles/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:responsive && npm run test:visual",
    "test:unit": "vitest run",
    "test:responsive": "playwright test tests/e2e/landing-widths.spec.ts tests/e2e/styleguide-widths.spec.ts tests/e2e/landing-webkit.spec.ts",
    "test:visual": "playwright test tests/e2e/landing-visual.spec.ts tests/e2e/styleguide-visual.spec.ts --project=chromium",
    "test:visual:update": "playwright test tests/e2e/landing-visual.spec.ts tests/e2e/styleguide-visual.spec.ts --project=chromium --update-snapshots"
  },
  "dependencies": {
    "@google/genai": "^1.20.0",
    "@neon/config": "^1.7.3",
    "@neon/env": "^1.4.4",
    "@neondatabase/auth": "^0.5.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "geist": "^1.7.0",
    "lucide-react": "^0.475.0",
    "next": "^16.3.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ts-fsrs": "^5.2.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.37.0",
    "eslint-config-next": "^16.3.6",
    "postcss": "^8.5.3",
    "postcss-custom-media": "^12.0.2",
    "stylelint": "^17.15.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
