# Neon Database & Pooling
DATABASE_URL=postgresql://neondb_owner:password@ep-example-pooler.c-6.eu-central-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:password@ep-example.c-6.eu-central-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require
APP_DATABASE_URL=postgresql://grasp_app:password@ep-example-pooler.c-6.eu-central-1.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=production

# Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL=https://ep-example.neonauth.c-6.eu-central-1.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-example.neonauth.c-6.eu-central-1.aws.neon.tech/neondb/auth/.well-known/jwks.json
NEON_AUTH_COOKIE_SECRET=generate_with_openssl_rand_base64_32

# Access
OWNER_EMAILS=owner@example.com

# Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_CRITICAL=
ENABLE_WEB_SEARCH=false

# Research (optional)
JINA_API_KEY=

# Scheduled generation
CRON_SECRET=generate_with_openssl_rand_base64_32

# Daily quotas
MAX_REVIEWS_PER_DAY=20
MAX_CAPTURES_PER_DAY=10
MAX_EXPLAIN_PER_DAY=30
MAX_THEMES_PER_DAY=1
MAX_PROPOSAL_REFRESH_PER_DAY=3

# Public URL
NEXT_PUBLIC_SITE_URL=https://grasp-gold.vercel.app
